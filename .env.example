# Beispiel-Env für YipYip. Kopiere nach .env (ist gitignored) und fülle die Werte.
# NIEMALS echte Keys committen.

# ── Audio-Pipeline (ElevenLabs) ──────────────────────────────────────
ELEVENLABS_API_KEY=
# Erzählstimme: Funke, Warum, Verankern, Reflektieren, Weitergehen.
ELEVENLABS_VOICE_ID=hOBDmVrVUuqtp1I3KsIq
# Stimme der geführten Übungen (Meditationen, Fantasiereisen). Betrifft genau die
# Schritte mit `audioSkript` — Modul 2 und 10 erklären im „Erleben" nur den
# Selbsttest und behalten deshalb die Erzählstimme.
ELEVENLABS_VOICE_ID_ERLEBEN=rAmra0SCIYOxYmRNDSm3

# ── AI-Engine (Phase 1) ──────────────────────────────────────────────
# EU-Inferenz über Mistral (Frankreich). Nur serverseitig genutzt (Route),
# nie im Client-Bundle. Vor echtem Go-Live: ZDR/Scale-Plan aktivieren.
MISTRAL_API_KEY=

# Feature-Gate der AI-Engine. Standard AUS. Erst auf "true" setzen, wenn das
# Go-Live-Gate offen ist (DPIA fertig, ZDR aktiv, Lana-Ton-Review, KI-Hinweis
# geprüft — siehe konzept/22_DPIA.md). Ohne "true" bleibt die Engine
# unsichtbar/inaktiv, auch wenn ein Key gesetzt ist.
NEXT_PUBLIC_ENGINE_ENABLED=false

# ── AI-Engine Phase 2a (Dialog + lokales Gedächtnis) ─────────────────
# Eigenes Gate, getrennt von Phase 1: solange dies nicht "true" ist, bleibt der
# dialogische Spiegel unsichtbar und /api/dialog antwortet mit 503 — die laufende
# Phase-1-Alpha ist davon unberührt. Vor dem Anschalten: Lana-Ton-Review der
# Dialog-Texte, DPIA um den Dialog-Datenfluss ergänzen (siehe konzept/23).
NEXT_PUBLIC_DIALOG_ENABLED=false
